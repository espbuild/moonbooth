{
  "version": "0.1",
  "notes": "Each case names an input and the expected outcome. Package cases with digest_mode \"compute\" have the runner compute the correct digest for the given files before validating, so the expected error is the named one and not a digest mismatch. A file entry with contentRepeat expands to char repeated count times.",
  "cases": [
    {
      "id": "valid-manifest",
      "kind": "manifest",
      "input": {
        "manifest": {
          "act_version": "0.1",
          "capability": {
            "id": "sample-capability",
            "name": "Sample Capability",
            "version": "1.0.0",
            "description": "A sample capability used by conformance fixtures."
          },
          "artifact": {
            "format": "agent-skills",
            "entrypoint": "SKILL.md",
            "digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          },
          "requirements": {
            "tools": [],
            "configuration": []
          },
          "requested_permissions": {
            "network": false,
            "filesystem_write": false,
            "external_side_effects": false
          },
          "verification": {
            "test_manifest": "tests/manifest.json"
          }
        }
      },
      "expected": {
        "ok": true
      }
    },
    {
      "id": "manifest-unknown-field",
      "kind": "manifest",
      "input": {
        "manifest": {
          "act_version": "0.1",
