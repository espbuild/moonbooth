    {
      "id": "valid-transition-sequence",
      "kind": "transition",
      "input": {
        "dimension": "lifecycle",
        "initial": "DRAFT",
        "steps": [
          "AWAITING_SENDER_APPROVAL",
          "OFFERED",
          "RECEIVED",
          "INSPECTED",
          "ACCEPTED"
