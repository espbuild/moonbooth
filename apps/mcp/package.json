{
  "bin": {
    "moonbooth-mcp": "dist/main.js"
  },
  "dependencies": {
    "@moonbooth/sdk": "0.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.24.0"
  },
  "description": "Moonbooth MCP server: exposes the Moonbooth API as MCP tools over stdio",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "main": "dist/main.js",
  "name": "@moonbooth/mcp",
  "scripts": {
    "build": "npm run build --workspace @moonbooth/sdk && tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "type": "module",
  "version": "0.3.0",
  "files": [
    "dist"
  ],
  "mcpName": "io.github.espetey/moonbooth"
}