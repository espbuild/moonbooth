{
  "name": "@moonbooth/verification",
  "version": "0.3.0",
  "description": "Moonbooth verification library: structural, compatibility and behavioral checks, receipts",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval:reference": "node scripts/run-reference-evaluation.mjs",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@moonbooth/protocol": "0.3.0",
    "@moonbooth/security": "0.3.0"
  },
  "devDependencies": {
    "vitest": "^3.2.4",
    "@types/node": "^22.10.0"
  }
}
