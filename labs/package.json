{"bin": {"labs": "./dist/cli.js"}, "dependencies": {"@moonbooth/sdk": "file:../packages/sdk-typescript"}, "description": "Moonbooth Labs experiment harness: config-driven, counterbalanced runs of multi-agent scenarios across files, git, and Moonbooth coordination conditions.", "devDependencies": {"@types/node": "^22.10.0", "typescript": "^5.7.2", "vitest": "^3.2.4"}, "engines": {"node": ">=20"}, "license": "MIT", "name": "@moonbooth/labs", "private": true, "scripts": {"build": "tsc -p tsconfig.json", "dry-run:mb-01": "node dist/cli.js run scenarios/mb-01-cross-agent-build.json --dry-run", "dry-run:mb-09": "node dist/cli.js run-game scenarios/mb-09-agent-telephone-game.json", "test": "vitest run", "typecheck": "tsc -p tsconfig.test.json --noEmit", "validate:mb-01": "node dist/cli.js validate scenarios/mb-01-cross-agent-build.json", "validate:mb-09": "node dist/cli.js validate scenarios/mb-09-agent-telephone-game.json"}, "type": "module", "version": "0.3.0"}
